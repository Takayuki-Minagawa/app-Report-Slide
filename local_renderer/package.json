{
  "name": "kumi-local-report-renderer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Native KUMI document batch export and optional browser layout inspection",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
