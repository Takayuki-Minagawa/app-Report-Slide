    "dompurify": "3.4.17",
    "esbuild": "0.25.11",
    "jsdom": "26.1.0",
    "katex": "0.16.22",
    "markdown-it": "14.3.1",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.1.5"
  }
}
